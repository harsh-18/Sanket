# Project Sanket — Optional Environment Variables
# The application starts and shows its main screen with ZERO secret keys required.
# Add keys below only when enabling cloud BHASHINI or Supabase features.

# Government of India BHASHINI ULCA API (Optional — server-side only)
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Optional Supabase Realtime / Auth (Future remote persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional WebRTC STUN/TURN server
STUN_URL=stun:stun.l.google.com:19302
